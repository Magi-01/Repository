) +
geom_text(
data = subset(data_tv_jury, Stage == "Final"),
aes(label = Country, color = jury_effect,
size = ifelse(nchar(Country) > 10, 5.5, 6.5)),
hjust  = 0,
lineheight = 0.8,
nudge_x    = 0.02
) +
scale_size_identity() +
scale_x_discrete(
expand = expansion(add = c(0.25, 0.75))
) +
scale_y_reverse(
limits = c(max(data_tv_jury$Rank, na.rm = TRUE) + 1, 1),
breaks = seq(1, max(data_tv_jury$Rank, na.rm = TRUE))
) +
