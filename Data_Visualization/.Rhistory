plot_layout(guides = "collect")
) &
scale_color_gradient2(
low      = "#1a9850",
mid      = "grey85",
high     = "#d73027",
midpoint = 0,
limits   = c(-max_abs, max_abs),
breaks   = c(-max_abs, max_abs),
labels   = c("Improved", "Worsened"),
name     = NULL,
guide    = guide_colorbar(
barwidth  = 1.5,
barheight = 4,
ticks     = FALSE,
reverse   = TRUE
)
) &
scale_alpha_manual(
values = c("neutral"  = 0.25,
