      <aliases enabled='yes' />
      <column caption='Bubble Size' datatype='real' hidden='true' name='[Bubble_Size]' role='measure' type='quantitative' />
      <column caption='Min spearman year' datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([spearman_per_year]) = WINDOW_MIN(MIN([spearman_per_year])) THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LookUpDown' datatype='real' name='[Calculation_0745784838664200]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([spearman_per_year]), -1)) THEN SUM([spearman_per_year])&#13;&#10;ELSEIF SUM([spearman_per_year]) &gt;= LOOKUP(SUM([spearman_per_year]), -1) &#13;&#10;THEN SUM([spearman_per_year])&#13;&#10;ELSE -SUM([spearman_per_year])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Normalised Spearman' datatype='real' name='[Calculation_0745784844541964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(SUM([spearman_per_year])) THEN -1&#13;&#10;ELSE&#13;&#10;    2 * (&#13;&#10;        (SUM([spearman_per_year]) - WINDOW_MIN(SUM([spearman_per_year])))&#13;&#10;        / &#13;&#10;        (WINDOW_MAX(SUM([spearman_per_year])) - WINDOW_MIN(SUM([spearman_per_year])))&#13;&#10;    ) - 1&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Televote_Effect' datatype='real' hidden='true' name='[Calculation_0745784851177493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Place_Televote] - [Poll_Rank]' />
      </column>
      <column caption='Jury_Effect' datatype='real' hidden='true' name='[Calculation_0745784851349526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Place_Jury] - [Place_Televote]' />
      </column>
      <column caption='Abs_TV_vs_Poll' datatype='real' hidden='true' name='[Calculation_0745784851460119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Calculation_0745784865529896])' />
      </column>
      <column caption='Abs_Jury' datatype='real' hidden='true' name='[Calculation_0745784851496984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Calculation_0745784865730602])' />
      </column>
      <column caption='Median_TV' datatype='real' hidden='true' name='[Calculation_0745784851562521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN([Calculation_0745784851460119])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Median_Jury' datatype='real' hidden='true' name='[Calculation_0745784851603482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN([Calculation_0745784851496984])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='TV_Category' datatype='string' hidden='true' name='[Calculation_0745784853389340]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Place_Televote] - [Poll_Rank]) &gt; [Calculation_0745784851562521] THEN &quot;worsened&quot;&#13;&#10;ELSEIF SUM([Place_Televote] - [Poll_Rank]) &lt; -[Calculation_0745784851562521] THEN &quot;improved&quot;&#13;&#10;ELSE &quot;neutral&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='JR_Category ' datatype='string' hidden='true' name='[Calculation_0745784853897245]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Place Jury] - [Poll Rank]) &gt; [Median_Jury] THEN &quot;worsened&quot;&#13;&#10;ELSEIF SUM([Place Jury] - [Poll Rank]) &lt; -[Median_Jury] THEN &quot;improved&quot;&#13;&#10;ELS&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Worsened_TV_Flag' datatype='integer' hidden='true' name='[Calculation_0745784855167006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Place_Televote] - [Poll_Rank]) &gt; WINDOW_MEDIAN(ABS(SUM([Place_Televote] - [Poll_Rank]))) THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
