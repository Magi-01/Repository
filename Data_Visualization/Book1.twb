    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ff5500' fontsize='28'>POLL</run>
            <run fontalignment='1' fontsize='28'> VS </run>
            <run bold='true' fontalignment='1' fontcolor='#ff007f' fontsize='28'>TELE-VOTE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='eurovision_results4' name='federated.0koivz307n7h4c1euqgbg0mxm4u6' />
          </datasources>
          <datasource-dependencies datasource='federated.0koivz307n7h4c1euqgbg0mxm4u6'>
            <column caption='Min spearman year' datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([spearman_per_year]) = WINDOW_MIN(MIN([spearman_per_year])) THEN 1 ELSE 0 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LookUpDown' datatype='real' name='[Calculation_0745784838664200]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([spearman_per_year]), -1)) THEN SUM([spearman_per_year])&#13;&#10;ELSEIF SUM([spearman_per_year]) &gt;= LOOKUP(SUM([spearman_per_year]), -1) &#13;&#10;THEN SUM([spearman_per_year])&#13;&#10;ELSE -SUM([spearman_per_year])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Normalised Spearman' datatype='real' name='[Calculation_0745784844541964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(SUM([spearman_per_year])) THEN -1&#13;&#10;ELSE&#13;&#10;    2 * (&#13;&#10;        (SUM([spearman_per_year]) - WINDOW_MIN(SUM([spearman_per_year])))&#13;&#10;        / &#13;&#10;        (WINDOW_MAX(SUM([spearman_per_year])) - WINDOW_MIN(SUM([spearman_per_year])))&#13;&#10;    ) - 1&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Year as format' datatype='date' name='[Year_as_format]' role='dimension' type='ordinal' />
            <column-instance column='[spearman_per_year]' derivation='None' name='[none:spearman_per_year:qk]' pivot='key' type='quantitative' />
            <column caption='Spearman Per Year' datatype='real' name='[spearman_per_year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk:6]' pivot='key' type='quantitative'>
              <table-calc ordering-type='TableCol' />
            </column-instance>
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Calculation_0745784838664200]' derivation='User' name='[usr:Calculation_0745784838664200:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='TableCol' />
            </column-instance>
            <column-instance column='[Calculation_0745784844541964]' derivation='User' name='[usr:Calculation_0745784844541964:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Year_as_format]' derivation='Year' name='[yr:Year_as_format:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0koivz307n7h4c1euqgbg0mxm4u6].[usr:Calculation1:qk]' included-values='in-range'>
            <min>1</min>
            <max>1</max>
          </filter>
          <filter class='categorical' column='[federated.0koivz307n7h4c1euqgbg0mxm4u6].[yr:Year_as_format:ok]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[yr:Year_as_format:ok]' member='2016' />
