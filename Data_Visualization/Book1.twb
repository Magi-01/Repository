              <calculation class='tableau' formula='CASE [Pivot Field Names]&#13;&#10;WHEN &quot;Poll Rank&quot; THEN &quot;Poll&quot;&#13;&#10;WHEN &quot;Place Televote&quot; THEN &quot;Televote&quot;&#13;&#10;WHEN &quot;Place Jury&quot; THEN &quot;Jury&quot;&#13;&#10;WHEN &quot;Place&quot; THEN &quot;Final&quot;&#13;&#10;END' />
